@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isBuyer = User.IsInRole("Buyer");
}

<style>
    :root {
        --primary-color: #4a6b57;
        --secondary-color: #6c757d;
        --success-color: #28a745;
        --danger-color: #dc3545;
        --warning-color: #ffc107;
        --info-color: #17a2b8;
        --light-color: #f8f9fa;
        --dark-color: #343a40;
        --border-color: #dee2e6;
    }

    .sidebar {
        width: 250px;
        background: white;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        box-shadow: 2px 0 10px rgba(0,0,0,0.05);
        display: flex;
        flex-direction: column;
        z-index: 1000;
        transition: width 0.3s ease;
    }

    .sidebar.collapsed {
        width: 70px;
    }

    .sidebar.collapsed .sidebar-header h1 {
        display: none;
    }

    .sidebar.collapsed .sidebar-header {
        justify-content: center;
        padding: 1.5rem 0;
    }

    .sidebar.collapsed .sidebar-menu li {
        padding: 0.8rem 0;
        justify-content: center;
    }

    .sidebar.collapsed .sidebar-menu li a span.menu-text {
        display: none;
    }
    
    .sidebar.collapsed .sidebar-menu li a {
        justify-content: center;
    }

    .sidebar.collapsed .sidebar-menu li i {
        margin-right: 0;
        font-size: 1.2rem;
    }

    .sidebar.collapsed .sidebar-footer {
        padding: 1.5rem 0;
        display: flex;
        justify-content: center;
    }

    .sidebar.collapsed .logout-btn span.menu-text {
        display: none;
    }

    .sidebar.collapsed .logout-btn {
        justify-content: center;
        width: auto;
    }

    .sidebar.collapsed .logout-btn i {
        margin-right: 0;
        font-size: 1.2rem;
    }

    body .main-content {
        margin-left: 250px;
        height: 100vh;
        padding: 2rem;
        overflow-y: auto;
        width: calc(100% - 250px);
        transition: margin-left 0.3s ease, width 0.3s ease;
    }

    body .main-content.expanded {
        margin-left: 70px !important;
        width: calc(100% - 70px) !important;
    }

    .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.5rem;
        border-bottom: 1px solid var(--border-color);
    }

    .sidebar-header h1 {
        color: var(--primary-color);
        font-size: 2.0rem;
        font-weight: 600;
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .sidebar-menu {
        flex: 1;
        padding: 1rem 0;
        list-style: none;
        margin: 0;
    }

    .sidebar-menu li {
        padding: 0.8rem 1.5rem;
        display: flex;
        align-items: center;
        cursor: pointer;
        color: #555;
        position: relative;
    }

    .sidebar-menu li i {
        margin-right: 0.8rem;
        width: 20px;
        text-align: center;
    }

    .sidebar-menu li.active {
        background: var(--light-color);
        color: var(--primary-color);
        border-left: 3px solid var(--primary-color);
    }

    .sidebar-menu li a {
        text-decoration: none;
        color: inherit;
        display: flex;
        align-items: center;
        width: 100%;
    }

    .sidebar-menu li:hover {
        background: var(--light-color);
    }

    .sidebar-footer {
        padding: 1.5rem;
        border-top: 1px solid var(--border-color);
    }

    .logout-btn {
        color: #555;
        text-decoration: none;
        display: flex;
        align-items: center;
        background: none;
        border: none;
        cursor: pointer;
        width: 100%;
        text-align: left;
        font-size: 1rem;
    }

    .logout-btn i {
        margin-right: 0.8rem;
    }

    .logout-btn:hover {
        color: var(--primary-color);
    }

    .sidebar-toggle-btn {
        background: transparent;
        border: none;
        color: var(--primary-color);
        cursor: pointer;
        padding: 0.4rem;
        border-radius: 6px;
        outline: none;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .sidebar-toggle-btn:hover {
        background: rgba(74, 107, 87, 0.1);
    }

    .sidebar.collapsed .sidebar-toggle-btn {
        margin-right: 0;
    }

</style>

<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <h1 style="margin: 0; font-size: 1.7rem; color: var(--primary-color); font-weight: 600;">Leathrix</h1>
        <button id="sidebarToggle" class="sidebar-toggle-btn" title="Toggle Sidebar">
            <svg stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" height="20" width="20" xmlns="http://www.w3.org/2000/svg">
                <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                <line x1="9" x2="9" y1="3" y2="21"></line>
            </svg>
        </button>
    </div>
    <ul class="sidebar-menu">
        @if (isBuyer)
        {
            <li class="@(currentController == "Buyer" && currentAction == "Dashboard" ? "active" : "")" title="Dashboard">
                <a asp-controller="Buyer" asp-action="Dashboard">
                    <i class="fas fa-home"></i> <span class="menu-text">Dashboard</span>
                </a>
            </li>
            <li class="@(currentController == "Buyer" && currentAction == "CreateDemand" ? "active" : "")" title="Create Demand">
                <a asp-controller="Buyer" asp-action="CreateDemand">
                    <i class="fas fa-plus-square"></i> <span class="menu-text">Create Demand</span>
                </a>
            </li>
            <li class="@(currentController == "Order" ? "active" : "")" title="Orders">
                <a asp-controller="Order" asp-action="Index">
                    <i class="fas fa-shopping-cart"></i> <span class="menu-text">Orders</span>
                </a>
            </li>
            <li class="@(currentController == "Payment" ? "active" : "")" title="Payment History">
                <a asp-controller="Payment" asp-action="History">
                    <i class="fas fa-credit-card"></i> <span class="menu-text">Payment History</span>
                </a>
            </li>
        }
        else
        {
            <li class="@(currentController == "Seller" && currentAction == "Dashboard" ? "active" : "")" title="Dashboard">
                <a asp-controller="Seller" asp-action="Dashboard">
                    <i class="fas fa-tachometer-alt"></i> <span class="menu-text">Dashboard</span>
                </a>
            </li>
            <li class="@(currentController == "Seller" && currentAction == "Demands" ? "active" : "")" title="All Demands">
                <a asp-controller="Seller" asp-action="Demands">
                    <i class="fas fa-list"></i> <span class="menu-text">All Demands</span>
                </a>
            </li>
            <li class="@(currentController == "Seller" && currentAction == "MyBids" ? "active" : "")" title="My Bids">
                <a asp-controller="Seller" asp-action="MyBids">
                    <i class="fas fa-gavel"></i> <span class="menu-text">My Bids</span>
                </a>
            </li>
            <li class="@(currentController == "Seller" && currentAction == "Orders" ? "active" : "")" title="My Orders">
                <a asp-controller="Seller" asp-action="Orders">
                    <i class="fas fa-shopping-cart"></i> <span class="menu-text">My Orders</span>
                </a>
            </li>
            <li class="@(currentController == "Inventory" ? "active" : "")" title="Inventory">
                <a asp-controller="Inventory" asp-action="Index">
                    <i class="fas fa-box"></i> <span class="menu-text">Inventory</span>
                </a>
            </li>
        }
      
        <li title="AI Chatbot">
            <a href="#" onclick="toggleAIChatModal(); return false;">
                <i class="fas fa-robot"></i> <span class="menu-text">AI Chatbot</span>
            </a>
        </li>
        <li class="@(currentController == "Account" && currentAction == "Profile" ? "active" : "")" title="Profile">
            <a asp-controller="Account" asp-action="Profile">
                <i class="fas fa-user"></i> <span class="menu-text">Profile</span>
            </a>
        </li>
    </ul>
    <div class="sidebar-footer">
        <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
            @Html.AntiForgeryToken()
            <button type="button" class="logout-btn" title="Logout" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal">
                <i class="fas fa-sign-out-alt"></i> <span class="menu-text">Logout</span>
            </button>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('sidebarToggle');
        const mainContent = document.querySelector('.main-content');
        
        if (toggleBtn && sidebar) {
            toggleBtn.addEventListener('click', function() {
                sidebar.classList.toggle('collapsed');
                if (mainContent) mainContent.classList.toggle('expanded');
                localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
            });
        }
        
        // Restore state on load
        if (sidebar && localStorage.getItem('sidebarCollapsed') === 'true') {
            sidebar.classList.add('collapsed');
            if (mainContent) mainContent.classList.add('expanded');
        }
    });
</script>
